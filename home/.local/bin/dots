#!/usr/bin/env sh

set -e

DOTFILES_DIR="$(realpath "$HOME"/.dotfiles)"
DOTFILES_DIR_FILES="$DOTFILES_DIR/home/"
HOME_NORMALIZED="$(realpath "$HOME")/"

main() {
  case "$1" in
    sync)
      set -x
      rsync -av --checksum --stats --info=ALL --human-readable --omit-dir-times --mkpath "$DOTFILES_DIR_FILES" "$HOME_NORMALIZED"
      ;;
    diff)
      set -x
      diff -ru ~/.dotfiles/home/ /home/main/ | grep -v '^Only in ' | delta
      ;;
    adopt)
      nomalized_path="$(realpath "$2")"
      if [ -d "$nomalized_path" ] && [ "$nomalized_path" != / ]; then
        nomalized_path="$nomalized_path/"
      fi

      set -x
      rsync -av --checksum --stats --info=ALL --human-readable --omit-dir-times --mkpath $nomalized_path "$DOTFILES_DIR_FILES${nomalized_path#"$HOME_NORMALIZED"}"
      ;;
    *)
      printf "Command \"%s\" is not valid\n" "$1"
      exit 1
      ;;
  esac
}

main "$@"
